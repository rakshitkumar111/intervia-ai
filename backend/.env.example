# ==============================================================================
# AI-POWERED HUMANOID VIRTUAL INTERVIEWER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Security
SECRET_KEY=super-secret-production-key-for-ai-interviewer-2026-btech
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; can use PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/interviewer_db
DATABASE_URL=sqlite:///interviewer.db

# ------------------------------------------------------------------------------
# Primary Production AI Provider: Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Alternative Provider: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Strict AI Mode:
# When 'true', requests will raise an explicit 503 error if the Gemini API key is missing or fails.
# When 'false', requests will gracefully invoke the labeled 'Development Fallback' engine.
STRICT_AI_MODE=false
